# Confidential legal documents: never served directly.
# They are streamed only through backend/api/admin/legal-records.php after an access check.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
Options -Indexes
